NODE_ENV=production
DATABASE_URL=postgresql://usuario:clave@host:5432/base
APP_URL=https://jesus1942.github.io/readBible/
CORS_ORIGINS=https://jesus1942.github.io,capacitor://localhost,https://localhost

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
COMMUNITY_ADMIN_CODE=
COMMUNITY_DEVELOPER_CODE=

# Solo para crear la primera cuenta si la tabla superadmin_account esta vacia.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=

# Login web. No usa client secret.
GOOGLE_CLIENT_ID_WEB=

# Login nativo: se usan cuando se instale ReadBibleNativeAuth en cada app.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

EVENT_DEFAULT_DURATION_MINUTES=120
CHECK_IN_EARLY_MINUTES=30
LIVE_PRESENCE_TTL_SECONDS=180

# Estructura preparada; el cobro permanece inactivo hasta configurar el flujo.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
ADMIN_PLAN_PRICE_ARS=
